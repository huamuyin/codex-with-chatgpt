{
  "manifest_version": 3,
  "name": "C2C V2 Control Plane PoC",
  "version": "0.8.1",
  "description": "Local-only control bridge for one ordinary ChatGPT tab.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "alarms",
    "scripting",
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:18796 ws://127.0.0.1:18796"
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "component_identity.js",
        "adapter_contract.js",
        "transcript_locator.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
